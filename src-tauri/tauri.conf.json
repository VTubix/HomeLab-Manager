{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "HomeLab Manager",
    "version":  "0.3.0",
    "identifier":  "de.homelab.manager",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:5173",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "HomeLab Manager",
                                    "width":  1260,
                                    "height":  850,
                                    "minWidth":  650,
                                    "minHeight":  550
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data: https://github.com https://avatars.githubusercontent.com; connect-src \u0027self\u0027"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyNTA3QkVEOTk2MTFGOTgKUldTWUgyR1o3WHRRSW1iZ2xuclZrWHRmSXQ5M0JxS25YNk1RU0tPTTFWQ0NxUVFrTFJuaHFld3cK",
                                    "endpoints":  [
                                                      "https://github.com/VTubix/HomeLab-Manager/releases/latest/download/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}

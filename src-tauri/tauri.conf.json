{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HomeLab Manager",
  "version": "0.2.3",
  "identifier": "de.homelab.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HomeLab Manager",
        "width": 1260,
        "height": 850,
        "minWidth": 650,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://github.com https://avatars.githubusercontent.com; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "CONFIGURE_PUBLIC_KEY_BEFORE_RELEASE",
      "endpoints": [
        "https://github.com/CONFIGURE_OWNER/CONFIGURE_REPO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
